      #include <sys/types.h>
       #include <sys/stat.h>
       #include <unistd.h>
       #include <stdio.h>
       #include <fcntl.h>        
       #include <sys/stat.h>     
       #include <string.h>
       #include <stdlib.h>
     
     
     int main (){
     int fd[2];
     char data[20], data2[20],len;
  
     
     if(pipe(fd)==-1){
     perror("pipe failed");
     exit(0);
     }   
     
     printf("enter data\n");
     len = read(0,data, sizeof(data)-1);
     data[len]='\0';
               
     write(fd[1],data, strlen(data));
     printf("written %d bytes to fd[1]\n",len);
     
     len = read(fd[0],data2, sizeof(data2)-1);     
     printf("read from to fd[0]: len = %d\n",len);
     
     data2[len]='\0';
     
     
     printf("value from pipe : %s\n", data2);
     
     }
